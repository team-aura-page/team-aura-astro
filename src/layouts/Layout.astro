---
// Aquí arriba va el Javascript de servidor de Astro (entre los guiones).
// Recibimos el título como variable para que cada página tenga el suyo.
const { title } = Astro.props;

// Obtenemos la URL actual para saber qué botón del menú debe estar "activo"
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <title>{title}</title>

        <meta
            name="description"
            content="Web oficial del Team Aura en PokeMMO. Ranking de Shinys, ShinyWar, Tracker y utilidades para entrenadores."
        />

        <link rel="stylesheet" href="/css/style.css" />
        <link rel="icon" type="image/x-icon" href="/icons/favicon.ico" />
    </head>

    <body>
        <nav class="main-nav">
            <a
                href="/"
                class={`nav-item nav-start ${currentPath === "/" ? "active" : ""}`}
            >
                <img
                    src="https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/premier-ball.png"
                    alt="Inicio"
                />
                <span>Team Aura</span>
            </a>

            <a
                href="/showcase"
                class={`nav-item ${currentPath.includes("/showcase") ? "active" : ""}`}
            >
                <img src="/icons/showcase-ribbon.png" alt="Showcase" />
                <span>Showcase</span>
            </a>

            <a
                href="/shinywar"
                class={`nav-item ${currentPath.includes("/shinywar") ? "active" : ""}`}
            >
                <img
                    src="https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/lucky-punch.png"
                    alt="ShinyWar"
                />
                <span>ShinyWar</span>
            </a>

            <a
                href="/shinydex"
                class={`nav-item ${currentPath.includes("/shinydex") ? "active" : ""}`}
            >
                <img src="/icons/shinydex.png" alt="Shinydex" />
                <span>ShinyDex</span>
            </a>

            <a
                href="/tracker"
                class={`nav-item ${currentPath.includes("/tracker") ? "active" : ""}`}
            >
                <img src="/icons/rotom.png" alt="Tracker" />
                <span>Tracker</span>
            </a>
        </nav>

        <slot />

        <script src="/js/cursors.js" is:inline></script>
        <script src="/js/stars.js" is:inline></script>
    </body>
</html>
