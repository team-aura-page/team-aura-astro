---
import { ClientRouter } from "astro:transitions";
import Stars from "../components/Stars.astro";
import Nav from "../components/Nav.astro";

interface Props {
    title: string;
    bodyClass?: string;
    description?: string;
}

const {
    title,
    bodyClass,
    description = "Web oficial del Team Aura en PokeMMO. Ranking de Shinys, ShinyWar, Tracker y utilidades para entrenadores.",
} = Astro.props;

// Construcción de URLs absolutas para SEO y Redes Sociales
const canonicalURL = new URL(
    Astro.url.pathname,
    Astro.site || Astro.url.origin,
);
const ogImageURL = new URL(
    "/icons/logotipo_aura.png",
    Astro.site || Astro.url.origin,
);
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <ClientRouter />
        <meta name="description" content={description} />

        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL.href} />
        <meta property="og:image" content={ogImageURL.href} />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImageURL.href} />

        <link rel="canonical" href={canonicalURL.href} />
        <meta name="robots" content="index, follow" />

        <link
            rel="preload"
            href="/font/PokemonFireRed.otf"
            as="font"
            type="font/opentype"
            crossorigin
        />

        <link rel="stylesheet" href="/css/style.css" />
        <link rel="icon" href="/favicon.ico" sizes="any" />
        <meta name="theme-color" content="#121212" />
    </head>

    <body class={bodyClass}>
        <Nav />

        <div style="view-transition-name: page-content; display: flow-root;">
            <slot />
        </div>

        <Stars />
        <script>
            import "../scripts/cursors.js";

            let currentDirection = "";

            document.addEventListener("astro:before-preparation", (e: any) => {
                currentDirection = "";
                const toPath = new URL(e.to).pathname;

                const navOrder = [
                    "/",
                    "/showcase",
                    "/shinywar",
                    "/shinydex",
                    "/tracker",
                ];
                const getIndex = (path: string) =>
                    navOrder.findIndex((p) =>
                        p !== "/" ? path.startsWith(p) : path === "/",
                    );

                const fromIndex = getIndex(window.location.pathname);
                const toIndex = getIndex(toPath);

                if (
                    fromIndex !== -1 &&
                    toIndex !== -1 &&
                    fromIndex !== toIndex
                ) {
                    currentDirection =
                        toIndex > fromIndex ? "forward" : "backward";
                }

                if (currentDirection) {
                    document.documentElement.dataset.navDirection =
                        currentDirection;
                } else {
                    delete document.documentElement.dataset.navDirection;
                }
            });

            document.addEventListener("astro:before-swap", (e: any) => {
                if (currentDirection) {
                    e.newDocument.documentElement.dataset.navDirection =
                        currentDirection;
                }
            });
        </script>
    </body>
</html>

<style is:global>
    /* Desactivar el rebote del grupo para evitar movimientos verticales de la página entera o del contenedor */
    ::view-transition-group(root),
    ::view-transition-group(page-content) {
        animation: none;
    }

    /* Asegurar que el contenido se ancle arriba y no provoque saltos extraños si las páginas miden diferente */
    ::view-transition-old(page-content),
    ::view-transition-new(page-content) {
        mix-blend-mode: normal;
        object-position: top left;
        object-fit: none;
        height: 100%;
        width: 100%;
    }

    /* Navegación hacia la derecha (forward) */
    html[data-nav-direction="forward"]::view-transition-old(page-content) {
        animation:
            pt-slide-out-left 0.25s ease both,
            pt-fade-out 0.15s ease both;
    }
    html[data-nav-direction="forward"]::view-transition-new(page-content) {
        animation: pt-slide-in-right 0.3s ease 0.25s both;
    }

    /* Navegación hacia la izquierda (backward) */
    html[data-nav-direction="backward"]::view-transition-old(page-content) {
        animation:
            pt-slide-out-right 0.25s ease both,
            pt-fade-out 0.15s ease both;
    }
    html[data-nav-direction="backward"]::view-transition-new(page-content) {
        animation: pt-slide-in-left 0.3s ease 0.25s both;
    }

    @keyframes pt-fade-out {
        to {
            opacity: 0;
        }
    }
    @keyframes pt-slide-out-left {
        to {
            transform: translateX(-50px);
        }
    }
    @keyframes pt-slide-in-right {
        from {
            transform: translateX(50px);
            opacity: 0;
        }
    }
    @keyframes pt-slide-out-right {
        to {
            transform: translateX(50px);
        }
    }
    @keyframes pt-slide-in-left {
        from {
            transform: translateX(-50px);
            opacity: 0;
        }
    }
</style>
