---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Tracker - Team Aura" bodyClass="page-tracker">
    <main class="tracker-content-container">
        <div class="tracker-header-controls">
            <h1 class="tracker-main-title">TRACKER MENSUAL</h1>

            <button id="adminSaveBtn" style="display: none;">
                💾 GUARDAR CAMBIOS
            </button>

            <div class="month-navigation-container">
                <button id="prevMonthBtn" class="nav-arrow-btn">◀</button>
                <h2 id="currentMonthDisplay" class="month-display-text">
                    Cargando...
                </h2>
                <button id="nextMonthBtn" class="nav-arrow-btn">▶</button>
            </div>
        </div>

        <div
            class="tracker-stats-wrapper"
            id="statsContainer"
            style="display: flex; flex-direction: column; align-items: center; gap: 15px;"
        >
            <div class="tracker-stat-item">
                <span style="margin: 0 10px;">Total del mes:</span>
                <span
                    id="totalCount"
                    style="color: var(--gold); font-weight: bold;">0</span
                >
            </div>

            <div id="leaderboard" class="tracker-leaderboard"></div>
        </div>

        <div id="trackerZones">
            <div id="rareZone" style="display:none;">
                <h2 class="rare-header">
                    <img src="/icons/corona.png" class="rare-icon" alt="💎" />
                    SHINIES RARES
                    <img src="/icons/corona.png" class="rare-icon" alt="💎" />
                </h2>
                <div id="rareGrid" class="tracker-grid-container"></div>
            </div>

            <div id="normalZone">
                <h2
                    id="normalTitle"
                    style="display:none; color: #aaa; text-align: center; font-size: 1rem; margin-bottom: 20px;"
                >
                    ⬇️ Shinies Normales ⬇️
                </h2>

                <div id="trackerGrid" class="tracker-grid-container">
                    <div
                        style="grid-column: 1/-1; text-align: center; color: #666; padding: 50px;"
                    >
                        Cargando datos de la nube...
                    </div>
                </div>
            </div>
        </div>
    </main>

    <div id="admin-login-modal" class="modal-overlay hidden">
        <div class="modal-content" style="max-width: 400px;">
            <span id="close-admin-modal" class="close-btn">&times;</span>
            <h2 class="admin-modal-title">🔒 Zona Admin</h2>
            <form id="admin-login-form" class="admin-form">
                <input type="email" id="admin-email" placeholder="Correo electrónico" required class="admin-input">
                <input type="password" id="admin-password" placeholder="Contraseña" required class="admin-input">
                <button type="submit" id="admin-login-btn" class="admin-submit-btn">Iniciar sesión</button>
                <p id="admin-login-error" class="admin-error"></p>
            </form>
        </div>
    </div>

    <script>
        import "../scripts/tracker.js";
    </script>
</Layout>

<style>
    .admin-modal-title {
        color: var(--gold);
        margin-bottom: 20px;
    }
    .admin-form {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }
    .admin-input {
        background: #1a1a1a;
        border: 2px solid var(--gold);
        color: var(--text-white);
        padding: 12px;
        border-radius: 8px;
        font-family: inherit;
        font-size: 1rem;
        outline: none;
        transition: box-shadow 0.3s ease;
    }
    .admin-input:focus {
        box-shadow: 0 0 10px rgba(255, 204, 0, 0.4);
    }
    .admin-submit-btn {
        background: var(--gold);
        color: #000;
        padding: 12px;
        border-radius: 8px;
        border: none;
        font-family: inherit;
        font-size: 1.1rem;
        font-weight: bold;
    }
    .admin-submit-btn:hover {
        filter: brightness(1.1);
    }
    .admin-error {
        display: none;
        color: #f44336;
        text-align: center;
        font-size: 0.9rem;
    }
</style>
