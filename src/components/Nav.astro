---
const currentPath = Astro.url.pathname;
---
<nav class="main-nav">
    <a href="/" class={`nav-item nav-start ${currentPath === "/" ? "active" : ""}`}>
        <img src="https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/premier-ball.png" alt="Inicio" />
        <span>Team Aura</span>
    </a>
    <a href="/showcase" class={`nav-item ${currentPath.includes("/showcase") ? "active" : ""}`}>
        <img src="/icons/showcase-ribbon.png" alt="Showcase" />
        <span>Showcase</span>
    </a>
    <a href="/shinywar" class={`nav-item ${currentPath.includes("/shinywar") ? "active" : ""}`}>
        <img src="https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/lucky-punch.png" alt="ShinyWar" />
        <span>ShinyWar</span>
    </a>
    <a href="/shinydex" class={`nav-item ${currentPath.includes("/shinydex") ? "active" : ""}`}>
        <img src="/icons/shinydex.png" alt="Shinydex" />
        <span>ShinyDex</span>
    </a>
    <a href="/tracker" class={`nav-item ${currentPath.includes("/tracker") ? "active" : ""}`}>
        <img src="/icons/rotom.png" alt="Tracker" />
        <span>Tracker</span>
    </a>
</nav>

<style>
    .main-nav {
        position: sticky;
        top: 20px;
        z-index: 100;
        display: flex;
        justify-content: center;
        gap: 40px;
        padding: 15px 30px;
        margin: 0 auto 30px auto;
        width: max-content;
        max-width: 95%;
        background: rgba(17, 17, 17, 0.6);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 204, 0, 0.3);
        border-radius: 50px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5), 0 0 15px rgba(255, 204, 0, 0.1);
    }
    .nav-item {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 16px;
        border-radius: 30px;
        border: 1px solid transparent;
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        width: auto;
    }
    .nav-item img {
        width: 28px;
        height: 28px;
        object-fit: contain;
        transition: transform 0.3s ease;
    }
    .nav-item span {
        font-weight: bold;
        font-size: 1.2rem;
        color: var(--text-white);
        white-space: nowrap;
        transition: color 0.3s ease;
    }
    .nav-item.active {
        pointer-events: none;
    }
    .nav-item.active::before {
        content: "";
        position: absolute;
        top: -1px;
        left: -1px;
        right: -1px;
        bottom: -1px;
        border-radius: 30px;
        background: rgba(255, 204, 0, 0.15);
        border: 1px solid rgba(255, 204, 0, 0.4);
        view-transition-name: nav-active-indicator;
        z-index: -1;
    }
    .nav-item.active span {
        color: var(--gold);
    }
    .nav-start {
        display: flex;
    }
    .nav-item:not(.active):hover {
        background: rgba(255, 255, 255, 0.1);
        transform: translateY(-2px);
    }
    .nav-item:not(.active):hover span {
        color: var(--gold);
        text-shadow: 0 0 8px rgba(255, 204, 0, 0.4);
    }
    .nav-item:hover img {
        transform: scale(1.1) rotate(-5deg);
    }
    @media (max-width: 900px) {
        .nav-start {
            position: static;
            transform: none;
            margin-bottom: 10px;
        }
        .main-nav {
            gap: 20px;
        }
    }
    @media (max-width: 600px) {
        .main-nav {
            gap: 15px;
            padding: 12px 15px;
            width: 100%;
            max-width: 100%;
            border-radius: 0;
            top: 0;
            margin-bottom: 20px;
            justify-content: flex-start;
            flex-wrap: nowrap;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
            border-right: none;
            border-left: none;
        }
        .main-nav::-webkit-scrollbar {
            display: none;
        }
        .nav-item span {
            font-size: 1.2rem;
        }
        .nav-item img {
            width: 28px;
            height: 28px;
        }
        .nav-start img {
            width: 35px;
            height: 35px;
        }
    }
</style>
